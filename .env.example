# Postgres. Locally: postgres://localhost:5432/proxima. On Vercel: set by the Neon integration.
DATABASE_URL=postgres://localhost:5432/proxima

# OpenAI (https://platform.openai.com/api-keys) — required for the agents.
OPENAI_API_KEY=

# Apify (https://console.apify.com/account/integrations) — scrapes LinkedIn + Instagram.
# Without it the app falls back to public pages, which often get blocked.
APIFY_TOKEN=

# Protects /admin, bulk add and season runs. Also signs worker ticks.
ADMIN_KEY=

# Optional: friends who open /add?invite=<code> join the demo season directly.
INVITE_CODE=

# Optional overrides
# PUBLIC_ORIGIN=http://localhost:3000
# MODEL_READ=gpt-6.1-sol
# MODEL_DATE=gpt-6.1-sol
# MODEL_SPEED=gpt-6.1-sol   (gpt-6-luna for a cheaper round 1)
# MODEL_DEBRIEF=gpt-6.1-sol
# FULL_DATES_PER_PERSON=3
# FULL_DATE_TURNS=12
# WORKER_CONCURRENCY=6
